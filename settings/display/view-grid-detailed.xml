<!--
  Theme: Albedo
  Author: mluizvitor
-->

<theme>
  <formatVersion>7</formatVersion>

  <!--Confugurações da view i"grid"-->
  <customView name="grid-detailed" inherits="grid">
    <imagegrid name="gamegrid">
      <scrollDirection>vertical</scrollDirection>
      <autoLayout>3 3</autoLayout>
      <autoLayout ifSubset="Ratio:5-3">3 2</autoLayout>
      <scrollLoop>false</scrollLoop>
      <imageSource>thumbnail</imageSource>

      <pos>0 0.2</pos>      <!-- 480x320 / 0x 64y-->
      <size>0.5 0.8</size>      <!--480x320 / 480x 256y-->
      <size ifHelpPrompts="true">0.5 0.725</size>      <!--480x320 / 480x 232y-->
      <margin>0.033333 0.05</margin>      <!-- 480x320 / 16x 8y -->
      <padding>0.033333 0.075</padding>      <!-- 480x320 / 32x 0y -->

      <autoLayoutSelectedZoom>1.075</autoLayoutSelectedZoom>

      <gameImage>./assets/icons/cartridge=1-1.png</gameImage>
      <gameImage ifSubset="DefaultGridIconsRatio:2-3">./assets/icons/cartridge=2-3.png</gameImage>

      <folderImage>./assets/icons/folder=1-1.png</folderImage>
      <folderImage ifSubset="DefaultGridIconsRatio:2-3">./assets/icons/folder=2-3.png</folderImage>

      <storyboard>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
        <animation property="y" from="0.25" to="0.2" duration="300" mode="EaseOut"/>
      </storyboard>
    </imagegrid>

    <image name="grid_background" extra="true">
      <path>./assets/ratio32/gamelist-grid-dtl-bg.png</path>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>5</zIndex>
    </image>

    <image name="grid_background" extra="true" ifSubset="Ratio:4-3">
      <path>./assets/ratio43/gamelist-grid-dtl-bg.png</path>
    </image>

    <image name="grid_background" extra="true" ifSubset="Ratio:5-3">
      <path>./assets/ratio53/gamelist-grid-dtl-bg.png</path>
    </image>

    <gridtile name="default, selected">
      <padding>3 3</padding>
      <padding ifSubset="Ratio:4-3">4 4</padding>
      <padding ifSubset="Ratio:5-3">6 6</padding>

      <selectionMode>image</selectionMode>

      <imageSizeMode ifSubset="gridImageStyle:cover">minSize</imageSizeMode>
      <imageSizeMode ifSubset="gridImageStyle:fit">maxSize</imageSizeMode>
      <imageSizeMode ifSubset="gridImageStyle:stretch">size</imageSizeMode>
    </gridtile>

    <gridtile name="default">
      <backgroundColor>00000000</backgroundColor>
    </gridtile>

    <gridtile name="selected">
      <backgroundColor>${primaryColorAlt}</backgroundColor>
    </gridtile>

    <image name="gridtile.image">
      <roundCorners>0</roundCorners>
    </image>


    <image name="gridtile.image:selected">
      <roundCorners>0</roundCorners>
    </image>

    <ninepatch name="gridtile.background">
      <path>./assets/ratio32/grid-selector.png</path>
      <cornerSize>16 16</cornerSize>
    </ninepatch>

    <ninepatch name="gridtile.background" ifSubset="Ratio:4-3">
      <path>./assets/ratio43/grid-selector.png</path>
    </ninepatch>

    <ninepatch name="gridtile.background" ifSubset="Ratio:5-3">
      <path>./assets/ratio53/grid-selector.png</path>
    </ninepatch>

    <image name="gridtile.marquee">
      <visible>false</visible>
    </image>

    <text name="gridtile">
      <fontSize>${fontSizeBody2-medium}</fontSize>
      <fontSize ifSubset="FontSize:small">${fontSizeBody2-small}</fontSize>
      <fontSize ifSubset="FontSize:large">${fontSizeBody2-large}</fontSize>

      <fontPath>${typefaceRegular}</fontPath>
      <alignment>left</alignment>
      <singleLineScroll>false</singleLineScroll>
      <lineSpacing>0.9</lineSpacing>
      <backgroundColor>00000099</backgroundColor>

      <size>1 0.25</size>
      <pos>0 0.7</pos>
      <padding>0.066666667 0 0.066666667 0</padding>

      <color>${primaryColorLightVariant}</color>
    </text>

    <text name="md_name">
      <origin>0 0.5</origin>      <!--vertical center-->
      <pos>0.033333333 0.15</pos>      <!--480x320 / 24x 48y-->
      <size>0.508333333 ${fontSizeBody2-medium}</size>
      <size ifSubset="Ratio:5-3">0.58 ${fontSizeBody2Medium}</size>

      <fontSize>${fontSizeBody2-medium}</fontSize>
      <fontSize ifSubset="FontSize:small">${fontSizeBody2-small}</fontSize>
      <fontSize ifSubset="FontSize:large">${fontSizeBody2-large}</fontSize>

      <fontPath>${typefaceRegular}</fontPath>
      <alignment>left</alignment>
      <zIndex>10</zIndex>

      <storyboard>
        <animation property="y" from="0.175" to="0.15" duration="300" mode="EaseOut"/>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </text>

    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.383333</pos>      <!-- 480x320 / 344x 136y -->
      <maxSize>0.425 0.5</maxSize>      <!-- 480x320 / 240x 160y -->
      <zIndex>4</zIndex>
      <roundCorners>0.02</roundCorners>
      <path>./assets/icons/cartridge=1-1.png</path>
    </image>

    <image name="md_marquee">
      <pos>0.75 0.183333</pos>      <!-- 480x320 / 344x 68y -->
      <origin>0.5 0.5</origin>      <!-- 480x320 / center center / -->
      <maxSize>0.425 0.166666</maxSize>      <!-- 480x320 / 208x 56y -->
      <zIndex>6</zIndex>
    </image>

    <datetime name="md_releasedate">
      <pos>0.825 0.7125</pos>
      <pos ifSubset="Ratio:16-9">0.841666667 0.71851852</pos>
      <visible ifHelpPrompts="true">0</visible>
      <size>0 0</size>

      <storyboard>
        <animation property="x" from="0.875" to="0.825" duration="300" mode="EaseOut"/>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </datetime>

    <image name="md_releasedate_icon">
      <pos>0.783333 0.7125</pos>
      <pos ifSubset="Ratio:16-9">0.80833333 0.71851852</pos>
      <visible ifHelpPrompts="true">0</visible>

      <storyboard>
        <animation property="x" from="0.833333333" to="0.783333" duration="300" mode="EaseOut"/>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </image>

    <text name="md_description">
      <pos>0.533333 0.75</pos>      <!-- 480x320 / 224x 240y-->
      <pos ifHelpPrompts="true">0.466666667 0.7</pos>      <!-- 480x320 / 224x 232y-->

      <size>0.433333 0.225</size>      <!-- 480x320 / 240x 64y-->
      <size ifHelpPrompts="true">0.433333 0.2</size>      <!-- 480x320 / 240x 64y-->

      <color>ffffff</color>
      <fontPath>${typefaceRegular}</fontPath>
      <fontSize>${fontSizeBody2-medium}</fontSize>
      <fontSize ifSubset="FontSize:small">${fontSizeBody2-small}</fontSize>
      <fontSize ifSubset="FontSize:large">${fontSizeBody2-large}</fontSize>
      <lineSpacing>0.9</lineSpacing>
    </text>

    <text name="md_description" ifSubset="Ratio:16-9">
      <pos>0.46666667 0.75555556</pos>      <!-- 480x320 / 224x 240y-->
      <pos ifHelpPrompts="true">0.46666667 0.6962963</pos>      <!-- 480x320 / 224x 232y-->

      <size>0.5 0.20740741</size>      <!-- 480x320 / 240x 64y-->
      <size ifHelpPrompts="true">0.5 0.20740741</size>      <!-- 480x320 / 240x 64y-->
    </text>

    <text name="md_description_label" extra="true">
      <text>${string.view.detailed.description}</text>

      <color>${primaryColorLightVariant}</color>
      <origin>0 0.5</origin>
      <pos>0.533333 0.7125</pos>
      <pos ifSubset="Ratio:16-9">0.46666667 0.71851852</pos>
      <size>0.3 ${fontSizeCaption-medium}</size>

      <fontSize>${fontSizeCaption-medium}</fontSize>
      <fontSize ifSubset="FontSize:small">${fontSizeCaption-small}</fontSize>
      <fontSize ifSubset="FontSize:large">${fontSizeCaption-large}</fontSize>
      <fontPath>${typefaceTitleBold}</fontPath>
      <forceUppercase>1</forceUppercase>

      <visible ifHelpPrompts="true">0</visible>
      <zIndex>20</zIndex>
    </text>

    <text name="md_description_label, md_description">
      <storyboard>
        <animation property="x" from="0.566666" to="0.533333" duration="300" mode="EaseOut"/>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </text>

    <rating name="md_rating">
      <origin>0 0.5</origin>
      <pos>0.816666667 0.6375</pos>
      <pos ifSubset="Ratio:16-9">0.81666667 0.65185185</pos>

      <storyboard>
        <animation property="x" from="0.833333" to="0.8" duration="300" mode="EaseOut"/>
        <animation property="opacity" from="0" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </rating>
  </customView>
</theme>
